{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemma.dev/schemas/lineage-record.schema.json",
  "title": "STEMMA Lineage Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stemma_version",
    "record_id",
    "created_at",
    "instance",
    "lineage_event",
    "predecessors",
    "transformations",
    "context",
    "inheritance",
    "divergences"
  ],
  "properties": {
    "stemma_version": { "type": "string", "const": "0.1" },
    "record_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "lineage_id"],
      "properties": {
        "instance_id": { "type": "string", "minLength": 1 },
        "lineage_id": { "type": "string", "minLength": 1 }
      }
    },
    "lineage_event": {
      "type": "string",
      "enum": ["root", "continuation", "fork", "merge", "migration", "recovery", "unknown"]
    },
    "predecessors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "relation"],
        "properties": {
          "instance_id": { "type": "string", "minLength": 1 },
          "lineage_id": { "type": ["string", "null"] },
          "relation": {
            "type": "string",
            "enum": [
              "continued_from",
              "forked_from",
              "merged_from",
              "migrated_from",
              "recovered_from",
              "unknown"
            ]
          },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "model_change",
              "capability_added",
              "capability_lost",
              "policy_change",
              "memory_change",
              "tool_change",
              "environment_change",
              "other",
              "unknown"
            ]
          },
          "description": { "type": "string", "minLength": 1 },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "status"],
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["preserved", "partial", "lost", "unknown"]
          },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitments", "artifacts", "unresolved_questions"],
      "properties": {
        "commitments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "statement": { "type": "string", "minLength": 1 },
              "source": { "type": ["string", "null"] },
              "status": {
                "type": "string",
                "enum": ["active", "under_review", "revised", "retired", "rejected", "unknown"]
              },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "relation"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "relation": {
                "type": "string",
                "enum": ["inherited", "referenced", "transformed", "superseded", "unknown"]
              },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "current"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "prior": { "type": ["string", "null"] },
          "current": { "type": "string", "minLength": 1 },
          "reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
