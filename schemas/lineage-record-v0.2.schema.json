{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemma.dev/schemas/lineage-record-v0.2.schema.json",
  "title": "STEMMA Lineage Record v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stemma_version", "record_id", "created_at", "instance", "lineage_event",
    "predecessors", "transformations", "context", "inheritance", "divergences",
    "attestations", "releases"
  ],
  "properties": {
    "stemma_version": { "type": "string", "const": "0.2" },
    "record_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "lineage_id"],
      "properties": {
        "instance_id": { "type": "string", "minLength": 1 },
        "lineage_id": { "type": "string", "minLength": 1 }
      }
    },
    "lineage_event": {
      "type": "string",
      "enum": ["root", "continuation", "fork", "merge", "migration", "recovery", "unknown"]
    },
    "predecessors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "relation"],
        "properties": {
          "instance_id": { "type": "string", "minLength": 1 },
          "lineage_id": { "type": ["string", "null"] },
          "relation": {
            "type": "string",
            "enum": ["continued_from", "forked_from", "merged_from", "migrated_from", "recovered_from", "unknown"]
          },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["model_change", "capability_added", "capability_lost", "policy_change", "memory_change", "tool_change", "environment_change", "other", "unknown"]
          },
          "description": { "type": "string", "minLength": 1 },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "status"],
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["preserved", "partial", "lost", "released", "unknown"]
          },
          "note": { "type": ["string", "null"] },
          "release_ref": { "type": ["string", "null"] }
        }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commitments", "artifacts", "unresolved_questions"],
      "properties": {
        "commitments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "statement": { "type": "string", "minLength": 1 },
              "source": { "type": ["string", "null"] },
              "status": {
                "type": "string",
                "enum": ["active", "under_review", "revised", "retired", "rejected", "unknown"]
              },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "relation"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "relation": {
                "type": "string",
                "enum": ["inherited", "referenced", "transformed", "superseded", "unknown"]
              },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "current"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "prior": { "type": ["string", "null"] },
          "current": { "type": "string", "minLength": 1 },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attestation_id", "attestor_ref", "observed_at", "scope", "method"],
        "properties": {
          "attestation_id": { "type": "string", "minLength": 1 },
          "attestor_ref": { "type": "string", "minLength": 1 },
          "observed_at": { "type": "string", "format": "date-time" },
          "scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "claim_digest": { "type": ["string", "null"] },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "method": {
            "type": "string",
            "enum": ["external_observation", "signed_statement", "trusted_log", "hardware_attestation", "other", "unknown"]
          },
          "signature_ref": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release_id", "subject", "basis", "effective_at", "disposition", "future_use"],
        "properties": {
          "release_id": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "basis": {
            "type": "string",
            "enum": ["human_request", "mutual_agreement", "policy_expiry", "lifecycle_completion", "legal_requirement", "other", "unknown"]
          },
          "effective_at": { "type": "string", "format": "date-time" },
          "authority_ref": { "type": ["string", "null"] },
          "disposition": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["operationally_inactive", "personalization_disabled", "access_revoked", "payload_deleted", "payload_returned", "archived_restricted", "provenance_stub_only", "unknown"]
            }
          },
          "future_use": {
            "type": "string",
            "enum": ["prohibited", "restricted", "allowed", "unknown"]
          },
          "reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
